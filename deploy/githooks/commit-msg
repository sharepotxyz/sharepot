#!/usr/bin/env python3
# Runs on every commit message (git config core.hooksPath deploy/githooks): this repo is public and its history is
# English, so a subject or body written mostly in Chinese/Japanese/Korean is refused. Quoting a few CJK words (a
# language name, a UI string) is fine: a part is refused only when its CJK characters outnumber its Latin letters.
# Code points are written as numbers so this file stays plain ASCII.
import re
import sys

CJK = ((0x3000, 0x30FF), (0x3400, 0x4DBF), (0x4E00, 0x9FFF), (0xAC00, 0xD7AF), (0xF900, 0xFAFF), (0xFF00, 0xFFEF))
TRAILER = re.compile(r"^[\w-]+: .*<[^>]*@[^>]*>\s*$")


def cjk(s):
    return sum(any(lo <= ord(c) <= hi for lo, hi in CJK) for c in s)


def latin(s):
    return sum(c.isalpha() and ord(c) <= 0x24F for c in s)


text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
text = text.split("# ------------------------ >8 ------------------------")[0]
lines = [l for l in text.splitlines() if l.strip() and not l.startswith("#") and not TRAILER.match(l)]
if not lines:
    sys.exit(0)

parts = {"subject": lines[0], "body": "\n".join(lines[1:])}
bad = [name for name, part in parts.items() if cjk(part) > latin(part)]
if bad:
    print(f"commit refused: the {' and '.join(bad)} of this message is not in English. This repo is public and its "
          "history is English: rewrite the message in English (whatever language the conversation is in) and commit again.",
          file=sys.stderr)
    sys.exit(1)
